---
import { ChevronsLeft, Rss, Search, X } from "lucide-react";
import layout from "../styles/page.module.css";

interface Props {
  /** 開いているのが検索ページなら "search"（サイドバーの「検索」を現在地として示す） */
  current?: "search";
  /** スロットにページ一覧（ツリーナビ）を入れるか。公開ページが無いツリーでは false にして、見出しも出さない */
  list?: boolean;
}

const { current, list = true } = Astro.props;

/**
 * サイドバーになる左の列。`.withNav` の中に置く。上に、サイト全体にまたがる「検索」「RSS」、その下に「ページ一覧」（スロットに入れたツリーナビ）を並べる。
 * 広い画面では左のサイドバーになり、狭い画面（800px 以下）ではヘッダーの「ページ一覧を開く」で開く左のドロワーになる
 * （同じ要素を CSS で切り替えるので、ツリーは1か所にしか出ない）。ヘッダーのボタンを出すのは Base.astro（`nav` を渡したとき）。
 * サイドバーは「サイドバーを閉じる」で閉じ、ヘッダーの「サイドバーを開く」で開く。閉じたことは localStorage に覚える（描く前に当てるのは Base.astro）。
 * スクリプトが動かなければ、サイドバーは開いたままで、ヘッダーのボタンはトップ（/）へのリンクのまま。
 */
---

<div class={layout.navBackdrop} data-nav-backdrop></div>
<aside id="site-nav" data-nav-drawer data-pagefind-ignore>
  <div class={layout.navInner}>
    <div class={layout.drawerHead}>
      <button type="button" class={layout.drawerClose} data-nav-close aria-label="ページ一覧を閉じる"><X size={20} aria-hidden="true" /></button>
      <button
        type="button"
        class={layout.sidebarClose}
        data-sidebar-close
        hidden
        aria-label="サイドバーを閉じる"
        title="サイドバーを閉じる"
        aria-controls="site-nav"
        aria-expanded="true"
      >
        <ChevronsLeft size={20} aria-hidden="true" />
      </button>
    </div>
    <nav class={layout.sideLinks} aria-label="サイト全体">
      <a href="/search" aria-current={current === "search" ? "page" : undefined}>
        <Search size={16} aria-hidden="true" />
        検索
      </a>
      <a href="/feed.xml">
        <Rss size={16} aria-hidden="true" />
        RSS
      </a>
    </nav>
    {
      list && (
        <>
          <h2 class={layout.listHeading}>ページ一覧</h2>
          <slot />
        </>
      )
    }
  </div>
</aside>

<script>
  import { SIDEBAR_CLOSED, SIDEBAR_STORAGE_KEY } from "../lib/nav";
  import { sidebarCloseFocusTarget } from "../lib/sidebarFocus";

  // ヘッダーのリンク（スクリプトが動かないときの行き先）を、ボタンに差しかえる。
  // 狭い画面ではドロワーを開き、広い画面では閉じたサイドバーを開く
  const drawer = document.querySelector<HTMLElement>("[data-nav-drawer]");
  const fallback = document.querySelector<HTMLAnchorElement>("[data-nav-toggle]");
  if (drawer && fallback) {
    const toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = fallback.className;
    toggle.innerHTML = fallback.innerHTML;
    toggle.setAttribute("aria-controls", drawer.id);
    toggle.toggleAttribute("data-nav-toggle", true);
    fallback.replaceWith(toggle);

    const root = document.documentElement;
    const close = drawer.querySelector<HTMLButtonElement>("[data-nav-close]");
    const backdrop = document.querySelector<HTMLElement>("[data-nav-backdrop]");
    const sidebarClose = drawer.querySelector<HTMLButtonElement>("[data-sidebar-close]");
    const narrow = matchMedia("(max-width: 800px)");

    // ヘッダーのボタンの名前と aria-expanded を、いまの幅での役目（ドロワーか、サイドバーか）に合わせる
    const syncToggle = () => {
      const sidebarOpen = !root.hasAttribute("data-sidebar-closed");
      const label = narrow.matches ? "ページ一覧を開く" : "サイドバーを開く";
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
      toggle.setAttribute("aria-expanded", String(narrow.matches ? root.hasAttribute("data-nav-open") : sidebarOpen));
      sidebarClose?.setAttribute("aria-expanded", String(sidebarOpen));
    };

    // 広い画面のサイドバーを閉じる・開く。次のページでも同じ状態にする（描く前に当てるのは Base.astro）
    // 動かす間だけ付ける（読み込み時の状態は動かさない。CSS は Base.module.css と page.module.css）
    let animating: ReturnType<typeof setTimeout> | undefined;
    const setSidebarClosed = (closed: boolean) => {
      clearTimeout(animating);
      root.setAttribute("data-sidebar-animating", "");
      animating = setTimeout(() => root.removeAttribute("data-sidebar-animating"), 250);
      root.toggleAttribute("data-sidebar-closed", closed);
      try {
        if (closed) localStorage.setItem(SIDEBAR_STORAGE_KEY, SIDEBAR_CLOSED);
        else localStorage.removeItem(SIDEBAR_STORAGE_KEY);
      } catch {
        // 覚えられないブラウザでも、このページの中では開閉できる
      }
      syncToggle();
      // 押したボタンは消えるので、入れ替わりに出たボタンへフォーカスを移す。どちらもスクロールはさせない（読んでいた位置にとどまる）
      // 開くときに「サイドバーを閉じる」へ移せるのは、開く動きでは visibility をすぐ切り替えているから（page.module.css）
      if (closed) focusAfterSidebarClose();
      else sidebarClose?.focus({ preventScroll: true });
    };

    // ヘッダーは本文と一緒に流れるので、読んでいる途中に閉じると「サイドバーを開く」は画面の外にある。
    // そのときは、画面に入っている本文の見出し（無ければ本文の領域）へ移し、次の Tab が読んでいた位置の続きへ進むようにする
    const focusAfterSidebarClose = () => {
      const main = drawer.parentElement?.querySelector<HTMLElement>("main") ?? null;
      const headings = Array.from(main?.querySelectorAll<HTMLElement>("h1, h2, h3, h4, h5, h6") ?? []);
      const target = sidebarCloseFocusTarget(
        { el: toggle as HTMLElement, rect: toggle.getBoundingClientRect() },
        headings.map((el) => ({ el, rect: el.getBoundingClientRect() })),
        main,
        window.innerHeight,
      );
      if (!target) return;
      // 見出しと main はもともとフォーカスできないので、移す間だけ tabindex="-1" を付け、外れたら戻す
      if (target !== toggle && !target.hasAttribute("tabindex")) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
      }
      target.focus({ preventScroll: true });
    };
    let inerted: HTMLElement[] = [];

    // 開いている間は、ドロワーのほか（ヘッダー・本文・フッター）を操作できないようにする（フォーカスもドロワーの中にとどまる）
    const inertOthers = () => {
      for (let el: HTMLElement | null = drawer; el && el !== document.body; el = el.parentElement) {
        for (const sibling of Array.from(el.parentElement?.children ?? [])) {
          if (sibling !== el && sibling !== backdrop && sibling instanceof HTMLElement && !sibling.inert) {
            sibling.inert = true;
            inerted.push(sibling);
          }
        }
      }
    };

    const setOpen = (open: boolean, restoreFocus = true) => {
      if (root.hasAttribute("data-nav-open") === open) return;
      root.toggleAttribute("data-nav-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      if (open) {
        drawer.setAttribute("role", "dialog");
        drawer.setAttribute("aria-modal", "true");
        drawer.setAttribute("aria-label", "ページ一覧");
        inertOthers();
        close?.focus();
      } else {
        drawer.removeAttribute("role");
        drawer.removeAttribute("aria-modal");
        drawer.removeAttribute("aria-label");
        for (const el of inerted) el.inert = false;
        inerted = [];
        if (restoreFocus) toggle.focus();
      }
    };

    syncToggle();
    if (sidebarClose) {
      sidebarClose.hidden = false;
      sidebarClose.addEventListener("click", () => setSidebarClosed(true));
    }
    toggle.addEventListener("click", () => (narrow.matches ? setOpen(true) : setSidebarClosed(false)));
    close?.addEventListener("click", () => setOpen(false));
    backdrop?.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && root.hasAttribute("data-nav-open")) setOpen(false);
    });
    // リンクを押したら閉じる（ページはそのまま移る）
    drawer.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest("a[href]")) setOpen(false, false);
    });
    // 広い画面に変わったら閉じる（ツリーは左のサイドバーに戻る）
    narrow.addEventListener("change", (e) => {
      if (!e.matches) setOpen(false, false);
      syncToggle();
    });
  }
</script>
