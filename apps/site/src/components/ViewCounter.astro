---
// 閲覧数を数える（公開の記事のページだけに置く。限定公開のページには置かない）。
// 同じブラウザが同じ記事を同じ日（JST）に何度開いても1回。覚えておくのは「この記事を数えた日」だけで、サーバーには記事の ID しか送らない
interface Props {
  pageId: string;
}
const { pageId } = Astro.props;
---

<div data-count-view={pageId} hidden></div>

<script>
  const STORAGE_KEY = "wiki:viewed";
  const pageId = document.querySelector<HTMLElement>("[data-count-view]")?.dataset.countView;

  /** JST の今日（YYYY-MM-DD） */
  const today = () => new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);

  function count(id: string) {
    const day = today();
    let viewed: Record<string, string>;
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}");
      viewed = saved && typeof saved === "object" ? saved : {};
    } catch {
      // 保存できないブラウザでは、同じ日の2回目を見分けられないので送らない
      return;
    }
    if (viewed[id] === day) return;
    if (!navigator.sendBeacon?.("/_v", id)) return;
    // 今日のぶんだけを残す（前の日の記録は要らない）
    const next = Object.fromEntries(Object.entries(viewed).filter(([, d]) => d === day));
    next[id] = day;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
    } catch {
      // 保存できなくても、表示には関わらない
    }
  }

  /** 実際に表示されてから送る（先読み・裏のタブで開いただけでは送らない） */
  function whenShown(run: () => void) {
    const doc = document as Document & { prerendering?: boolean };
    if (doc.prerendering) {
      document.addEventListener("prerenderingchange", () => whenShown(run), { once: true });
    } else if (document.visibilityState !== "visible") {
      const onVisible = () => {
        if (document.visibilityState !== "visible") return;
        document.removeEventListener("visibilitychange", onVisible);
        run();
      };
      document.addEventListener("visibilitychange", onVisible);
    } else {
      run();
    }
  }

  // 自動操作のブラウザ（navigator.webdriver）は数えない
  if (pageId && !navigator.webdriver) whenShown(() => count(pageId));
</script>
