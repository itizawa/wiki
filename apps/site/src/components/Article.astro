---
import s from "./Article.module.css";
import { renderArticle } from "../lib/markdown";

interface Props {
  title: string;
  bodyMd: string;
  firstPublishedAt?: string;
  revisedAt: string;
  monetization?: Record<string, unknown> | null;
  publicPaths: ReadonlyMap<string, string>;
  /** この wiki のオリジン。絶対URLで書かれた内部リンクを見分ける */
  origin: string;
}

const { title, bodyMd, firstPublishedAt, revisedAt, monetization, publicPaths, origin } = Astro.props;
// 収益化フラグがある記事は広告である旨を表示し、外部リンクに rel="sponsored" を付ける（12.3）
const sponsored = Boolean(monetization && (monetization.affiliate || monetization.sponsored));
const { html, headings } = renderArticle(bodyMd, { publicPaths, sponsored, origin });
// 見出しが2つ以上あるときだけ目次を出す。いちばん浅い見出しを左端に揃える
const showToc = headings.length >= 2;
const minDepth = Math.min(...headings.map((h) => h.depth));
const fmt = (iso: string) =>
  new Intl.DateTimeFormat("ja-JP", { timeZone: "Asia/Tokyo", dateStyle: "long" }).format(new Date(iso));
const revised = firstPublishedAt && fmt(revisedAt) !== fmt(firstPublishedAt);
---

<article class={s.article}>
  <h1>{title}</h1>
  <div class={s.meta}>
    {firstPublishedAt && <time datetime={firstPublishedAt}>{fmt(firstPublishedAt)}</time>}
    {revised && <span>（{fmt(revisedAt)} 更新）</span>}
    {sponsored && <span class={s.adNotice}>広告を含みます</span>}
  </div>
  {
    showToc && (
      <nav class={s.toc} aria-label="目次" data-toc data-pagefind-ignore>
        <details open>
          <summary>目次</summary>
          <ol>
            {headings.map((h) => (
              <li style={`--indent: ${h.depth - minDepth}`}>
                <a href={`#${h.id}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
    )
  }
  <div class={s.body} set:html={html} />
</article>

<script>
  // 目次の中で、いま読んでいる節を示す（画面の上端を過ぎた、いちばん下の見出し）
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("nav[data-toc] a")];
  if (tocLinks.length > 0) {
    const targets = tocLinks.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let current: HTMLAnchorElement | undefined;
    let queued = false;
    const update = () => {
      queued = false;
      let index = 0;
      targets.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top <= 24) index = i;
      });
      // ページの最後まで来たら、上端に届かない最後の節を「いま」にする
      if (window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) index = tocLinks.length - 1;
      const next = tocLinks[index];
      if (next === current) return;
      current?.removeAttribute("aria-current");
      next?.setAttribute("aria-current", "location");
      current = next;
      // 目次が長くて中でスクロールするとき、いまの節が見える位置に来るようにする
      if (next && getComputedStyle(next.closest("nav")!).position === "sticky") next.scrollIntoView({ block: "nearest" });
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }

  // コードブロックの右上に「コピー」ボタンを足す（クリップボードが使えない環境では足さない）。
  // 横にはみ出す行があるブロックには、「折り返す」の切り替えも足す
  for (const pre of document.querySelectorAll<HTMLPreElement>("article pre")) {
    const overflows = pre.scrollWidth > pre.clientWidth;
    if (!navigator.clipboard && !overflows) continue;
    const wrap = document.createElement("div");
    wrap.dataset.codeBlock = "";
    pre.replaceWith(wrap);
    const tools = document.createElement("div");
    tools.dataset.codeTools = "";
    if (overflows) {
      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.textContent = "折り返す";
      toggle.setAttribute("aria-pressed", "false");
      toggle.addEventListener("click", () => {
        const on = wrap.toggleAttribute("data-code-wrap");
        toggle.setAttribute("aria-pressed", String(on));
        toggle.textContent = on ? "✓ 折り返す" : "折り返す";
      });
      tools.append(toggle);
    }
    if (navigator.clipboard) {
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = "コピー";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent ?? "");
          button.textContent = "コピーしました";
        } catch {
          button.textContent = "コピーできませんでした";
        }
        setTimeout(() => (button.textContent = "コピー"), 2000);
      });
      tools.append(button);
    }
    // 読み上げとキーボード操作で、コードより先にボタンに着くようにする
    wrap.append(tools, pre);
  }

  // 本文の画像を、クリックでページの上に重ねて大きく表示する。リンクの中の画像は、リンク先へ移るのでそのままにする。
  // 画像をボタンで包むので、キーボード（Enter / Space）でも開ける
  const article = document.querySelector("article");
  let zoom: { dialog: HTMLDialogElement; image: HTMLImageElement } | undefined;
  let zoomOpener: HTMLButtonElement | undefined;
  const openZoom = (opener: HTMLButtonElement, source: HTMLImageElement) => {
    if (!zoom) {
      const dialog = document.createElement("dialog");
      dialog.dataset.imageZoom = "";
      dialog.setAttribute("aria-label", "画像の拡大表示");
      const close = document.createElement("button");
      close.type = "button";
      close.textContent = "閉じる";
      const image = document.createElement("img");
      // 背景（画像と「閉じる」以外のところ）か、画像そのものを押したら閉じる
      const content = document.createElement("div");
      content.dataset.imageZoomContent = "";
      content.append(close, image);
      dialog.append(content);
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog || e.target === content || e.target === image || e.target === close) dialog.close();
      });
      // Esc・背景・「閉じる」のどれで閉じても、フォーカスを元の画像に戻す
      dialog.addEventListener("close", () => zoomOpener?.focus());
      article!.append(dialog);
      zoom = { dialog, image };
    }
    zoomOpener = opener;
    zoom.image.src = source.currentSrc || source.src;
    zoom.image.alt = source.alt;
    zoom.dialog.showModal();
  };
  if (article && typeof HTMLDialogElement !== "undefined") {
    for (const img of article.querySelectorAll<HTMLImageElement>("img")) {
      if (img.closest("a, button")) continue;
      const button = document.createElement("button");
      button.type = "button";
      button.dataset.imageZoomOpen = "";
      button.setAttribute("aria-label", img.alt ? `画像を拡大する: ${img.alt}` : "画像を拡大する");
      img.replaceWith(button);
      button.append(img);
      button.addEventListener("click", () => openZoom(button, img));
    }
  }
</script>
