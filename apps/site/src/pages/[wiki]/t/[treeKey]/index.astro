---
import layout from "../../../../styles/page.module.css";
import type { ManifestTree } from "@wiki/shared";
import TreeNav from "../../../../components/TreeNav";
import Base from "../../../../layouts/Base.astro";
import { allWikis, fullNav, TREE_LABEL } from "../../../../lib/manifest";

export async function getStaticPaths() {
  return (await allWikis()).flatMap((w) => w.trees.map((tree) => ({ params: { wiki: w.key, treeKey: tree.key }, props: { tree } })));
}

const { tree } = Astro.props as { tree: ManifestTree };
const { wiki } = Astro.params;
---

<Base wiki={wiki} title={TREE_LABEL}>
  <h1>{TREE_LABEL}</h1>
  {tree.nodes.length === 0 && <p class={layout.muted}>まだ記事はありません。</p>}
  <TreeNav client:idle items={await fullNav(wiki, tree)} />
</Base>
