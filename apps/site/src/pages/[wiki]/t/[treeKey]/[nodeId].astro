---
import layout from "../../../../styles/page.module.css";
import type { ManifestPage, ManifestTree } from "@wiki/shared";
import Article from "../../../../components/Article.astro";
import TreeNav from "../../../../components/TreeNav";
import Base from "../../../../layouts/Base.astro";
import { allWikis, siteData } from "../../../../lib/manifest";
import { excerpt } from "../../../../lib/markdown";
import { ancestors, navItems } from "../../../../lib/tree";

// ツリー経由の閲覧：本文を再掲し、ツリーナビを付ける。正規URLは /p/...（重複コンテンツ対策）。
// ビルド量は「公開ページ数 × 公開ツリー数」に比例する（設計書 6章）。
export async function getStaticPaths() {
  return (await allWikis()).flatMap((w) => {
    const pagesById = new Map(w.pages.map((p) => [p.id, p]));
    return w.trees.flatMap((tree) =>
      tree.nodes
        .filter((n) => pagesById.has(n.pageId))
        .map((n) => ({ params: { wiki: w.key, treeKey: tree.key, nodeId: n.nodeId }, props: { tree, page: pagesById.get(n.pageId)! } })),
    );
  });
}

const { tree, page } = Astro.props as { tree: ManifestTree; page: ManifestPage };
const { wiki } = Astro.params;
const { pagesById, publicPaths, origin } = await siteData(wiki);
const titleOf = (id: string) => pagesById.get(id)?.title;
const crumbs = ancestors(tree, page.id).slice(0, -1);
---

<Base wiki={wiki} title={page.title} description={excerpt(page.bodyMd)} canonical={page.path}>
  <div class={layout.withNav}>
    <main data-pagefind-ignore>
      <nav class={layout.breadcrumbs}>
        <a href={`/t/${tree.key}/`}>{tree.name}</a>
        {
          crumbs.map((c) => (
            <>
              {" / "}
              <a href={`/t/${tree.key}/${c.nodeId}`}>{titleOf(c.pageId)}</a>
            </>
          ))
        }
      </nav>
      <Article
        title={page.title}
        bodyMd={page.bodyMd}
        firstPublishedAt={page.firstPublishedAt}
        revisedAt={page.revisedAt}
        monetization={page.monetization}
        publicPaths={publicPaths}
        origin={origin}
      />
    </main>
    <aside>
      <TreeNav client:idle items={navItems(tree, titleOf)} current={page.id} />
    </aside>
  </div>
</Base>
