---
import layout from "../../../../styles/page.module.css";
import type { ManifestPage, ManifestTree } from "@wiki/shared";
import Article from "../../../../components/Article.astro";
import NavDrawer from "../../../../components/NavDrawer.astro";
import TreeNav from "../../../../components/TreeNav";
import Base from "../../../../layouts/Base.astro";
import { allWikis, pageNav, siteData, TREE_LABEL } from "../../../../lib/manifest";
import { excerpt } from "../../../../lib/markdown";
import { NAV_DATA_PATH } from "../../../../lib/nav";
import { ancestors } from "../../../../lib/tree";
import Backlinks from "../../../../components/Backlinks.astro";
import ViewCounter from "../../../../components/ViewCounter.astro";
import { siteBacklinks } from "../../../../lib/backlinks";

// ツリー経由の閲覧：本文を再掲し、ツリーナビを付ける。正規URLは /p/...（重複コンテンツ対策）。
// ファイルの数は「公開ページ数 × 公開ツリー数」に比例する（設計書 6章）。本文の HTML は /p/ で作ったものを使い回す（Article.astro）。
export async function getStaticPaths() {
  return (await allWikis()).flatMap((w) => {
    const pagesById = new Map(w.pages.map((p) => [p.id, p]));
    return w.trees.flatMap((tree) =>
      tree.nodes
        .filter((n) => pagesById.has(n.pageId))
        .map((n) => ({ params: { wiki: w.key, treeKey: tree.key, nodeId: n.nodeId }, props: { tree, page: pagesById.get(n.pageId)! } })),
    );
  });
}

const { tree, page } = Astro.props as { tree: ManifestTree; page: ManifestPage };
const { wiki } = Astro.params;
const { pagesById, publicPaths, origin } = await siteData(wiki);
const titleOf = (id: string) => pagesById.get(id)?.title;
const backlinks = (await siteBacklinks(wiki)).get(page.id) ?? [];
const crumbs = ancestors(tree, page.id).slice(0, -1);
const nav = await pageNav(wiki, tree, page.id);
---

<Base wiki={wiki} title={page.title} description={excerpt(page.bodyMd)} canonical={page.path} nav="/">
  <div class={layout.withNav}>
    <main data-pagefind-ignore>
      <nav class={layout.breadcrumbs}>
        <a href={`/t/${tree.key}/`}>{TREE_LABEL}</a>
        {
          crumbs.map((c) => (
            <>
              {" / "}
              <a href={`/t/${tree.key}/${c.nodeId}`}>{titleOf(c.pageId)}</a>
            </>
          ))
        }
      </nav>
      <Article
        title={page.title}
        icon={page.icon}
        bodyMd={page.bodyMd}
        firstPublishedAt={page.firstPublishedAt}
        revisedAt={page.revisedAt}
        monetization={page.monetization}
        publicPaths={publicPaths}
        origin={origin}
      />
      <Backlinks pages={backlinks} />
      <ViewCounter pageId={page.id} />
    </main>
    <NavDrawer>
      <TreeNav client:idle items={nav} current={page.id} src={NAV_DATA_PATH} treeKey={tree.key} />
    </NavDrawer>
  </div>
</Base>
