---
import { resolveHome } from "@wiki/shared";
import article from "../../components/Article.module.css";
import page from "../../styles/page.module.css";
import Base from "../../layouts/Base.astro";
import { allWikis, siteData } from "../../lib/manifest";
import { excerpt, renderMarkdown } from "../../lib/markdown";

export async function getStaticPaths() {
  return (await allWikis()).map((w) => ({ params: { wiki: w.key } }));
}

const { wiki: manifest, publicPaths, origin } = await siteData(Astro.params.wiki);
// 管理画面の「トップページ」で書いた自由記述。内部リンクの解決は記事の本文と同じ
const { introMd } = resolveHome(manifest.home);
const introHtml = introMd ? renderMarkdown(introMd, { publicPaths, origin }) : null;
const fmt = new Intl.DateTimeFormat("ja-JP", { timeZone: "Asia/Tokyo", dateStyle: "medium" });
---

<Base wiki={manifest.key} title={manifest.name} canonical="/">
  {introHtml && <div class:list={[article.body, page.homeIntro]} data-home-intro set:html={introHtml} />}
  <h1 class={page.visuallyHidden}>新着記事</h1>
  {manifest.pages.length === 0 && <p class={page.muted}>まだ記事はありません。</p>}
  <ul class={page.postList}>
    {
      manifest.pages.map((p) => (
        <li>
          <h2>
            <a href={p.path}>{p.title}</a>
          </h2>
          <p>
            <time datetime={p.firstPublishedAt}>{fmt.format(new Date(p.firstPublishedAt))}</time> ・ {excerpt(p.bodyMd)}
          </p>
        </li>
      ))
    }
  </ul>
</Base>
