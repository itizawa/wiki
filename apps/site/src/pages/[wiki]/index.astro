---
import { resolveHome } from "@wiki/shared";
import article from "../../components/Article.module.css";
import NavDrawer from "../../components/NavDrawer.astro";
import TreeNav from "../../components/TreeNav";
import page from "../../styles/page.module.css";
import Base from "../../layouts/Base.astro";
import { allWikis, fullNav, siteData } from "../../lib/manifest";
import { webSiteJsonLd } from "../../lib/jsonLd";
import { excerpt, renderMarkdown } from "../../lib/markdown";

export async function getStaticPaths() {
  return (await allWikis()).map((w) => ({ params: { wiki: w.key } }));
}

const { wiki: manifest, publicPaths, origin, primaryTree, pagesById, linkPreviews, previewOf } = await siteData(Astro.params.wiki);
// 管理画面の「トップページ」で書いた自由記述。内部リンクの解決は記事の本文と同じ
const { introMd } = resolveHome(manifest.home);
const introHtml = introMd ? renderMarkdown(introMd, { publicPaths, origin, titleOf: (id) => pagesById.get(id)?.title, linkPreviews, previewOf }) : null;
// 検索結果の説明。自由記述が空なら出さない（空の説明を出さない）
const description = (introMd && excerpt(introMd)) || undefined;
const fmt = new Intl.DateTimeFormat("ja-JP", { timeZone: "Asia/Tokyo", dateStyle: "medium" });
// 公開ページが1つも無いツリーは出さない（新着だけにする）
const items = primaryTree ? await fullNav(manifest.key, primaryTree) : [];
const tree = items.length > 0 ? primaryTree : undefined;
---

<Base wiki={manifest.key} title={manifest.name} canonical="/" nav="/" description={description} jsonLd={webSiteJsonLd({ name: manifest.name, origin })}>
  <div class={page.withNav}>
    <main>
      {introHtml && <div class:list={[article.body, page.homeIntro]} data-home-intro set:html={introHtml} />}
      <h1 class={page.visuallyHidden}>新着記事</h1>
      {manifest.pages.length === 0 && <p class={page.muted}>まだ記事はありません。</p>}
      <ul class={page.postList}>
        {
          manifest.pages.map((p) => (
            <li>
              <h2>
                <a href={p.path}>{p.title}</a>
              </h2>
              <p>
                <time datetime={p.firstPublishedAt}>{fmt.format(new Date(p.firstPublishedAt))}</time> ・ {excerpt(p.bodyMd)}
              </p>
            </li>
          ))
        }
      </ul>
    </main>
    <NavDrawer list={tree !== undefined}>
      {tree && <TreeNav client:idle items={items} />}
    </NavDrawer>
  </div>
</Base>
