---
import layout from "../../../styles/page.module.css";
import type { ManifestPage } from "@wiki/shared";
import Article from "../../../components/Article.astro";
import NavDrawer from "../../../components/NavDrawer.astro";
import TreeNav from "../../../components/TreeNav";
import Base from "../../../layouts/Base.astro";
import { allWikis, navFile, pageNav, siteData } from "../../../lib/manifest";
import { excerpt } from "../../../lib/markdown";
import { ancestors, childrenItems } from "../../../lib/tree";
import Backlinks from "../../../components/Backlinks.astro";
import { siteBacklinks } from "../../../lib/backlinks";

export async function getStaticPaths() {
  return (await allWikis()).flatMap((w) => w.pages.map((page) => ({ params: { wiki: w.key, page: page.id }, props: { page } })));
}

const { page } = Astro.props as { page: ManifestPage };
const { wiki } = Astro.params;
const { pagesById, publicPaths, primaryTree, origin } = await siteData(wiki);
const titleOf = (id: string) => pagesById.get(id)?.title;
const backlinks = (await siteBacklinks(wiki)).get(page.id) ?? [];
const inPrimary = primaryTree?.nodes.some((n) => n.nodeId === page.id);
const crumbs = primaryTree && inPrimary ? ancestors(primaryTree, page.id).slice(0, -1) : [];
// ツリーは、最初の表示に出る分だけを HTML に入れる。残りは、ツリーナビが wiki ごとの JSON から読む
const nav = primaryTree && (await pageNav(wiki, primaryTree, inPrimary ? page.id : undefined));
const navSrc = (await navFile(wiki)).path;
---

<Base wiki={wiki} title={page.title} description={excerpt(page.bodyMd)} canonical={page.path} nav={primaryTree && "/"}>
  <div class={layout.withNav}>
    <main data-pagefind-body>
      {
        crumbs.length > 0 && (
          <nav class={layout.breadcrumbs} data-pagefind-ignore>
            {crumbs.map((c, i) => (
              <>
                {i > 0 && " / "}
                <a href={pagesById.get(c.pageId)?.path}>{titleOf(c.pageId)}</a>
              </>
            ))}
          </nav>
        )
      }
      <Article
        title={page.title}
        icon={page.icon}
        bodyMd={page.bodyMd}
        firstPublishedAt={page.firstPublishedAt}
        revisedAt={page.revisedAt}
        monetization={page.monetization}
        publicPaths={publicPaths}
        origin={origin}
        childrenOf={primaryTree && ((options) => childrenItems(primaryTree, page.id, options, pagesById))}
      />
      <Backlinks pages={backlinks} />
    </main>
    {
      primaryTree && nav && (
        <NavDrawer>
          <TreeNav client:idle items={nav} current={inPrimary ? page.id : undefined} src={navSrc} treeKey={primaryTree.key} />
        </NavDrawer>
      )
    }
  </div>
</Base>
