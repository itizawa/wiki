---
import type { ManifestUnlistedPage } from "@wiki/shared";
import Article from "../../../components/Article.astro";
import Base from "../../../layouts/Base.astro";
import { siteData } from "../../../lib/manifest";

// 限定公開：URLを知る人だけが到達できる。サイトマップ・RSS・ナビ・検索・リンクには一切出さない。
export async function getStaticPaths() {
  const { manifest } = await siteData();
  return manifest.unlisted.map((page) => ({ params: { key: page.key }, props: { page } }));
}

const { page } = Astro.props as { page: ManifestUnlistedPage };
const { pagesById } = await siteData();
const publicPaths = new Map([...pagesById].map(([id, p]) => [id, p.path]));
---

<Base title={page.title} noindex>
  <main data-pagefind-ignore="all">
    <Article title={page.title} bodyMd={page.bodyMd} revisedAt={page.revisedAt} publicPaths={publicPaths} />
  </main>
</Base>
