---
import type { ManifestTree } from "@wiki/shared";
import TreeNav from "../../../components/TreeNav";
import Base from "../../../layouts/Base.astro";
import { siteData } from "../../../lib/manifest";
import { navItems } from "../../../lib/tree";

export async function getStaticPaths() {
  const { manifest } = await siteData();
  return manifest.trees.map((tree) => ({ params: { treeKey: tree.key }, props: { tree } }));
}

const { tree } = Astro.props as { tree: ManifestTree };
const { pagesById } = await siteData();
---

<Base title={tree.name}>
  <h1>{tree.name}</h1>
  {tree.nodes.length === 0 && <p class="muted">まだ記事はありません。</p>}
  <TreeNav client:idle items={navItems(tree, (id) => pagesById.get(id)?.title)} />
</Base>
