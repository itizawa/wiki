---
import { NO_DECORATION_CSS_VARS, resolveTheme, themeCssVars, themeDecorationCssVars, themePresetFor, themeVariant } from "@wiki/shared";
import { googleTags } from "../lib/googleTags";
import { siteData } from "../lib/manifest";
import { SIDEBAR_CLOSED, SIDEBAR_STORAGE_KEY } from "../lib/nav";
import { Ellipsis, Menu, Presentation } from "lucide-react";
import "../styles/global.css";
import s from "./Base.module.css";

interface Props {
  /** どの wiki のページか（サイト名と canonical のオリジンが決まる） */
  wiki: string;
  title: string;
  description?: string;
  /** 正規URL */
  canonical?: string;
  /** 限定公開ページ */
  noindex?: boolean;
  /** 404 のページ。検索には出さない（noindex）が、Google のタグは出す */
  notFound?: boolean;
  /**
   * ツリーナビ（NavDrawer）を置いたページだけ渡す、トップのパス（`/`）。
   * 渡すと、広い画面ではツリーナビを左のサイドバーにし（閉じている間は、ヘッダーに「サイドバーを開く」を出す）、
   * 狭い画面ではヘッダーに「ページ一覧を開く」を出す（スクリプトが動かなければ、このパスへのリンクのまま）
   */
  nav?: string;
}

const { wiki, title, description, canonical, noindex = false, notFound = false, nav } = Astro.props;
const site = await siteData(wiki);
const SITE_NAME = site.wiki.name;
// 形式を確かめた色とパスだけを使う（マニフェストに無い・正しくない項目は既定に戻る）
const theme = resolveTheme(site.wiki.theme);
// wiki ごとのテーマの色の変数一式。global.css の :root より強い詳細度（html:root）で上書きし、読み込みの順番に頼らない。
// ライトのテーマを先に出し、端末の設定がダークのときだけ、あとからダークのテーマで上書きする
// 片方の版しか持たないテーマは、どちらの端末でもその版を出す
const preset = themePresetFor(theme.preset);
const light = themeVariant(preset, "light");
const dark = themeVariant(preset, "dark");
// 背景画像と飾りの変数。テーマにも wiki の画像にも無いモードは、もう一方のモードの画像を打ち消す（どちらにも無ければ、何も出さない）
const lightDecoration = themeDecorationCssVars(light, light.mode === "light" ? theme.backgroundLight : theme.backgroundDark);
const darkDecoration = themeDecorationCssVars(dark, dark.mode === "light" ? theme.backgroundLight : theme.backgroundDark) || (lightDecoration ? NO_DECORATION_CSS_VARS : "");
const withDecoration = (colors: string, decoration: string) => (decoration ? `${colors};${decoration}` : colors);
const themeCss = `html:root{${withDecoration(themeCssVars(light.colors), lightDecoration)}}@media (prefers-color-scheme: dark){html:root{${withDecoration(themeCssVars(dark.colors), darkDecoration)}}}`;
// 背景画像と飾りの要素は、どちらかのモードに画像があるときだけ置く
const hasBackdrop = Boolean(lightDecoration || darkDecoration);
const canonicalUrl = canonical ? new URL(canonical, site.origin).href : undefined;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// wiki ごとの設定（Google Analytics・サーチコンソール）。限定公開のページには出さない
const { gaMeasurementId, searchConsoleVerification, skipUnlistedPaths } = googleTags(site.wiki, { noindex, notFound });
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      theme.favicon ? (
        <link rel="icon" type={theme.favicon.endsWith(".webp") ? "image/webp" : "image/png"} href={theme.favicon} />
      ) : (
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      )
    }
    <style is:inline set:html={themeCss} />
    {
      nav && (
        <script is:inline define:vars={{ key: SIDEBAR_STORAGE_KEY, closed: SIDEBAR_CLOSED }}>
          // サイドバーを閉じていたら、描く前に閉じた状態にする（読み込みの途中で列が出たり消えたりしない）。開閉は NavDrawer.astro
          try {
            if (localStorage.getItem(key) === closed) document.documentElement.setAttribute("data-sidebar-closed", "");
          } catch {
            // localStorage を読めないブラウザでは、開いたままにする
          }
        </script>
      )
    }
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      noindex ? (
        <>
          <meta name="robots" content="noindex, nofollow" />
          <meta name="referrer" content="no-referrer" />
        </>
      ) : (
        <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed.xml" />
      )
    }
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}
    {
      gaMeasurementId && !skipUnlistedPaths && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
      )
    }
    {
      gaMeasurementId && (
        <script is:inline define:vars={{ gaMeasurementId, skipUnlistedPaths }}>
          // 404 のページは、無くなった限定公開の URL（/u/...）でも返る。その URL は Google へ送らない
          if (!(skipUnlistedPaths && location.pathname.startsWith("/u/"))) {
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag("js", new Date());
            window.gtag("config", gaMeasurementId);
            if (skipUnlistedPaths) {
              const tag = document.createElement("script");
              tag.async = true;
              tag.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaMeasurementId);
              document.head.appendChild(tag);
            }
          }
        </script>
      )
    }
  </head>
  <body class={nav ? s.hasNav : undefined}>
    <header class={s.header} data-site-header>
      {
        nav && (
          <a class={s.navToggle} href={nav} data-nav-toggle aria-label="ページ一覧を開く">
            <Menu size={20} aria-hidden="true" />
          </a>
        )
      }
      <a class={s.brand} href="/">
        {theme.logo ? <img class={s.logo} src={theme.logo} alt={SITE_NAME} height="32" /> : SITE_NAME}
      </a>
      {/* プレゼンモード。popover なので、スクリプトが動かなくても開閉できる（外を押す・Esc で閉じる）。出す項目が無いページでは、CSS が出さない。検索と RSS はサイドバー（NavDrawer.astro） */}
      <div class={s.menuWrap}>
        <button type="button" class={s.menuButton} popovertarget="site-menu" aria-label="メニュー" title="メニュー">
          <Ellipsis size={20} aria-hidden="true" />
        </button>
        <div id="site-menu" class={s.menu} popover data-pagefind-ignore>
          {/* スクリプト（Article.astro）が、スライドが2枚以上になる記事でだけ見えるようにする。動かなければ出ない */}
          <button type="button" hidden data-presentation-open popovertarget="site-menu" popovertargetaction="hide">
            <Presentation size={16} aria-hidden="true" />
            プレゼンモードで表示
          </button>
        </div>
      </div>
    </header>
    <div class={s.body}>
      <slot />
    </div>
    {/* リンクのプレビュー。本文のリンク（data-preview-title つき）にカーソルを載せる・フォーカスすると、下のスクリプトが中身を入れて出す。スクリプトが動かなければ出ない（リンクはそのまま使える） */}
    <div id="link-preview" class={s.linkPreview} popover="manual" role="tooltip" data-pagefind-ignore>
      <span class={s.previewSite} data-preview-site></span>
      <strong class={s.previewTitle}><span data-preview-icon aria-hidden="true"></span><span data-preview-title></span></strong>
      <span class={s.previewText} data-preview-text></span>
    </div>
    <footer class={s.footer}>© {SITE_NAME}</footer>
    {
      hasBackdrop && (
        <>
          {/* 背景画像と飾り。本文のあとに置き、後ろに固定する。押せず、読み上げず、印刷には出さない（global.css） */}
          <div class="theme-backdrop" aria-hidden="true" />
          <div class="theme-ornament" aria-hidden="true" />
        </>
      )
    }

{/* </html> のあとに書くと、Astro 7 はそのまま </html> のあとに出力する（5 では </body> の前へ動かしていた）ので、<body> の中に置く */}
<script>
  import { nextHeaderVisibility } from "../lib/headerVisibility";
  import { HOVER_DELAY_MS, previewPosition } from "../lib/linkPreviewPosition";

  // プレゼンモードを閉じたら、開いたメニューのボタンへフォーカスを戻す（メニューは閉じていて、押したボタンには戻せない）
  document.addEventListener(
    "close",
    (e) => {
      if (e.target instanceof HTMLElement && e.target.hasAttribute("data-presentation")) {
        document.querySelector<HTMLElement>("[popovertarget=site-menu]")?.focus({ preventScroll: true });
      }
    },
    true,
  );

  // リンクのプレビュー。ホバーは HOVER_DELAY_MS 待って出す。キーボードのフォーカス（:focus-visible）はすぐ出す。
  // マウスで押したあとのフォーカスでは出さず、タッチ端末（ホバーできない端末）では出さない。Esc・外す・スクロールで閉じる
  const card = document.getElementById("link-preview");
  if (card && typeof card.showPopover === "function") {
    const LINK = "a[data-preview-title]";
    const canHover = () => window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const part = (name: string) => card.querySelector<HTMLElement>(`[data-preview-${name}]`)!;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let current: HTMLAnchorElement | null = null;
    const hide = () => {
      clearTimeout(timer);
      if (current) current.removeAttribute("aria-describedby");
      current = null;
      if (card.matches(":popover-open")) card.hidePopover();
    };
    const show = (link: HTMLAnchorElement, point?: { x: number; y: number }) => {
      hide();
      const set = (name: string, v: string | undefined) => {
        part(name).textContent = v ?? "";
        part(name).hidden = !v;
      };
      set("site", link.dataset.previewSite);
      set("icon", link.dataset.previewIcon);
      set("title", link.dataset.previewTitle);
      set("text", link.dataset.previewText);
      card.showPopover();
      current = link;
      link.setAttribute("aria-describedby", card.id);
      // 複数行にまたがるリンクは、カーソルのある行（フォーカスなら最初の行）の下に置く
      const rects = [...link.getClientRects()];
      const rect = (point && rects.find((r) => point.y >= r.top && point.y <= r.bottom)) || rects[0] || link.getBoundingClientRect();
      const { left, top } = previewPosition(rect, { width: card.offsetWidth, height: card.offsetHeight }, { width: document.documentElement.clientWidth, height: window.innerHeight });
      card.style.left = `${left}px`;
      card.style.top = `${top}px`;
    };
    const linkOf = (e: Event) => (e.target instanceof Element ? (e.target.closest(LINK) as HTMLAnchorElement | null) : null);
    document.addEventListener("mouseover", (e) => {
      const link = linkOf(e);
      if (!link || link === current || !canHover()) return;
      clearTimeout(timer);
      timer = setTimeout(() => show(link, { x: e.clientX, y: e.clientY }), HOVER_DELAY_MS);
    });
    document.addEventListener("mouseout", (e) => {
      const link = linkOf(e);
      if (link && !link.contains(e.relatedTarget as Node | null)) hide();
    });
    document.addEventListener("focusin", (e) => {
      const link = linkOf(e);
      if (link && link.matches(":focus-visible")) show(link);
    });
    document.addEventListener("focusout", (e) => {
      if (linkOf(e)) hide();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") hide();
    });
    window.addEventListener("scroll", hide, { passive: true });
  }

  // 狭い画面で張り付くヘッダーを、下スクロールで隠し、上スクロールで戻す。
  // 張り付けるのも隠すのも CSS（Base.module.css）で、ここでは data-hidden を付け外しするだけ
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    let state = { hidden: false, anchorY: window.scrollY };
    let queued = false;
    const apply = (next: typeof state) => {
      if (next.hidden !== state.hidden) header.toggleAttribute("data-hidden", next.hidden);
      state = next;
    };
    const update = () => {
      queued = false;
      apply(
        nextHeaderVisibility(state, {
          scrollY: window.scrollY,
          maxScrollY: document.documentElement.scrollHeight - window.innerHeight,
          headerHeight: header.offsetHeight,
        }),
      );
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    // フォーカスが入って出たヘッダーが、フォーカスが外れたとたんに隠れ直さないようにする
    header.addEventListener("focusin", () => apply({ hidden: false, anchorY: window.scrollY }));
  }
</script>
  </body>
</html>
