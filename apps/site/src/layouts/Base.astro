---
import { siteData } from "../lib/manifest";
import "../styles/global.css";
import s from "./Base.module.css";

interface Props {
  /** どの wiki のページか（サイト名と canonical のオリジンが決まる） */
  wiki: string;
  title: string;
  description?: string;
  /** 正規URL（/t/ の再掲ページは /p/ を指す） */
  canonical?: string;
  /** 限定公開ページ */
  noindex?: boolean;
}

const { wiki, title, description, canonical, noindex = false } = Astro.props;
const site = await siteData(wiki);
const SITE_NAME = site.wiki.name;
const canonicalUrl = canonical ? new URL(canonical, site.origin).href : undefined;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      noindex ? (
        <>
          <meta name="robots" content="noindex, nofollow" />
          <meta name="referrer" content="no-referrer" />
        </>
      ) : (
        <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed.xml" />
      )
    }
  </head>
  <body>
    <header class={s.header} data-site-header>
      <a class={s.brand} href="/">{SITE_NAME}</a>
      {
        !noindex && (
          <nav class={s.nav}>
            <a href="/search">検索</a>
            <a href="/feed.xml">RSS</a>
          </nav>
        )
      }
    </header>
    <div class={s.body}>
      <slot />
    </div>
    <footer class={s.footer}>© {SITE_NAME}</footer>
  </body>
</html>

<script>
  import { nextHeaderVisibility } from "../lib/headerVisibility";

  // 狭い画面で張り付くヘッダーを、下スクロールで隠し、上スクロールで戻す。
  // 張り付けるのも隠すのも CSS（Base.module.css）で、ここでは data-hidden を付け外しするだけ
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    let state = { hidden: false, anchorY: window.scrollY };
    let queued = false;
    const apply = (next: typeof state) => {
      if (next.hidden !== state.hidden) header.toggleAttribute("data-hidden", next.hidden);
      state = next;
    };
    const update = () => {
      queued = false;
      apply(
        nextHeaderVisibility(state, {
          scrollY: window.scrollY,
          maxScrollY: document.documentElement.scrollHeight - window.innerHeight,
          headerHeight: header.offsetHeight,
        }),
      );
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    // フォーカスが入って出たヘッダーが、フォーカスが外れたとたんに隠れ直さないようにする
    header.addEventListener("focusin", () => apply({ hidden: false, anchorY: window.scrollY }));
  }
</script>
