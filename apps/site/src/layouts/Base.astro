---
import { resolveTheme } from "@wiki/shared";
import { googleTags } from "../lib/googleTags";
import { siteData } from "../lib/manifest";
import { SIDEBAR_CLOSED, SIDEBAR_STORAGE_KEY } from "../lib/nav";
import { Ellipsis, Menu, Presentation, Rss, Search } from "lucide-react";
import "../styles/global.css";
import s from "./Base.module.css";

interface Props {
  /** どの wiki のページか（サイト名と canonical のオリジンが決まる） */
  wiki: string;
  title: string;
  description?: string;
  /** 正規URL（/t/ の再掲ページは /p/ を指す） */
  canonical?: string;
  /** 限定公開ページ */
  noindex?: boolean;
  /** 404 のページ。検索には出さない（noindex）が、Google のタグは出す */
  notFound?: boolean;
  /**
   * ツリーナビ（NavDrawer）を置いたページだけ渡す、トップのパス（`/`）。
   * 渡すと、広い画面ではツリーナビを左のサイドバーにし（閉じている間は、ヘッダーに「サイドバーを開く」を出す）、
   * 狭い画面ではヘッダーに「階層を開く」を出す（スクリプトが動かなければ、このパスへのリンクのまま）
   */
  nav?: string;
}

const { wiki, title, description, canonical, noindex = false, notFound = false, nav } = Astro.props;
const site = await siteData(wiki);
const SITE_NAME = site.wiki.name;
// 形式を確かめた色とパスだけを使う（マニフェストに無い・正しくない項目は既定に戻る）
const theme = resolveTheme(site.wiki.theme);
// wiki ごとのアクセント色。global.css の :root より強い詳細度（html:root）で上書きし、読み込みの順番に頼らない
const themeCss = `html:root{--accent:${theme.accentLight}}@media (prefers-color-scheme: dark){html:root{--accent:${theme.accentDark}}}`;
const canonicalUrl = canonical ? new URL(canonical, site.origin).href : undefined;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// wiki ごとの設定（Google Analytics・サーチコンソール）。限定公開のページには出さない
const { gaMeasurementId, searchConsoleVerification, skipUnlistedPaths } = googleTags(site.wiki, { noindex, notFound });
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      theme.favicon ? (
        <link rel="icon" type={theme.favicon.endsWith(".webp") ? "image/webp" : "image/png"} href={theme.favicon} />
      ) : (
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      )
    }
    <style is:inline set:html={themeCss} />
    {
      nav && (
        <script is:inline define:vars={{ key: SIDEBAR_STORAGE_KEY, closed: SIDEBAR_CLOSED }}>
          // サイドバーを閉じていたら、描く前に閉じた状態にする（読み込みの途中で列が出たり消えたりしない）。開閉は NavDrawer.astro
          try {
            if (localStorage.getItem(key) === closed) document.documentElement.setAttribute("data-sidebar-closed", "");
          } catch {
            // localStorage を読めないブラウザでは、開いたままにする
          }
        </script>
      )
    }
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      noindex ? (
        <>
          <meta name="robots" content="noindex, nofollow" />
          <meta name="referrer" content="no-referrer" />
        </>
      ) : (
        <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed.xml" />
      )
    }
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}
    {
      gaMeasurementId && !skipUnlistedPaths && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
      )
    }
    {
      gaMeasurementId && (
        <script is:inline define:vars={{ gaMeasurementId, skipUnlistedPaths }}>
          // 404 のページは、無くなった限定公開の URL（/u/...）でも返る。その URL は Google へ送らない
          if (!(skipUnlistedPaths && location.pathname.startsWith("/u/"))) {
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag("js", new Date());
            window.gtag("config", gaMeasurementId);
            if (skipUnlistedPaths) {
              const tag = document.createElement("script");
              tag.async = true;
              tag.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaMeasurementId);
              document.head.appendChild(tag);
            }
          }
        </script>
      )
    }
  </head>
  <body class={nav ? s.hasNav : undefined}>
    <header class={s.header} data-site-header>
      {
        nav && (
          <a class={s.navToggle} href={nav} data-nav-toggle aria-label="階層を開く">
            <Menu size={20} aria-hidden="true" />
          </a>
        )
      }
      <a class={s.brand} href="/">
        {theme.logo ? <img class={s.logo} src={theme.logo} alt={SITE_NAME} height="32" /> : SITE_NAME}
      </a>
      {/* 検索・RSS・プレゼンモード。popover なので、スクリプトが動かなくても開閉できる（外を押す・Esc で閉じる）。中に出すものが無いページでは、CSS が出さない */}
      <div class={s.menuWrap}>
        <button type="button" class={s.menuButton} popovertarget="site-menu" aria-label="メニュー" title="メニュー">
          <Ellipsis size={20} aria-hidden="true" />
        </button>
        <div id="site-menu" class={s.menu} popover data-pagefind-ignore>
          {
            !noindex && (
              <>
                <a href="/search">
                  <Search size={16} aria-hidden="true" />
                  検索
                </a>
                <a href="/feed.xml">
                  <Rss size={16} aria-hidden="true" />
                  RSS
                </a>
              </>
            )
          }
          {/* スクリプト（Article.astro）が、スライドが2枚以上になる記事でだけ見えるようにする。動かなければ出ない */}
          <button type="button" hidden data-presentation-open popovertarget="site-menu" popovertargetaction="hide">
            <Presentation size={16} aria-hidden="true" />
            プレゼンモードで表示
          </button>
        </div>
      </div>
    </header>
    <div class={s.body}>
      <slot />
    </div>
    <footer class={s.footer}>© {SITE_NAME}</footer>

{/* </html> のあとに書くと、Astro 7 はそのまま </html> のあとに出力する（5 では </body> の前へ動かしていた）ので、<body> の中に置く */}
<script>
  import { nextHeaderVisibility } from "../lib/headerVisibility";

  // プレゼンモードを閉じたら、開いたメニューのボタンへフォーカスを戻す（メニューは閉じていて、押したボタンには戻せない）
  document.addEventListener(
    "close",
    (e) => {
      if (e.target instanceof HTMLElement && e.target.hasAttribute("data-presentation")) {
        document.querySelector<HTMLElement>("[popovertarget=site-menu]")?.focus({ preventScroll: true });
      }
    },
    true,
  );

  // 狭い画面で張り付くヘッダーを、下スクロールで隠し、上スクロールで戻す。
  // 張り付けるのも隠すのも CSS（Base.module.css）で、ここでは data-hidden を付け外しするだけ
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    let state = { hidden: false, anchorY: window.scrollY };
    let queued = false;
    const apply = (next: typeof state) => {
      if (next.hidden !== state.hidden) header.toggleAttribute("data-hidden", next.hidden);
      state = next;
    };
    const update = () => {
      queued = false;
      apply(
        nextHeaderVisibility(state, {
          scrollY: window.scrollY,
          maxScrollY: document.documentElement.scrollHeight - window.innerHeight,
          headerHeight: header.offsetHeight,
        }),
      );
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    // フォーカスが入って出たヘッダーが、フォーカスが外れたとたんに隠れ直さないようにする
    header.addEventListener("focusin", () => apply({ hidden: false, anchorY: window.scrollY }));
  }
</script>
  </body>
</html>
