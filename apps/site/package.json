{
  "name": "@wiki/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-manifest.mjs && astro build && node scripts/pagefind.mjs",
    "build:sample": "MANIFEST_PATH=fixtures/manifest.sample.json pnpm build && node scripts/verify-build.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "typecheck": "astro check && tsc -p tsconfig.worker.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@wiki/shared": "workspace:*",
    "astro": "^7.4.12",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pagefind": "^1.6.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
