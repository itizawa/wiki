{
  "name": "@wiki/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-manifest.mjs && astro build && pagefind --site dist",
    "build:sample": "MANIFEST_PATH=fixtures/manifest.sample.json pnpm build && node scripts/verify-build.mjs",
    "preview": "npx wrangler@4 pages dev dist",
    "typecheck": "astro check && tsc -p tsconfig.functions.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.12",
    "@wiki/shared": "workspace:*",
    "astro": "^5.18.2",
    "marked": "^16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pagefind": "^1.3.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
