DATABASE_URL=postgres://postgres:postgres@localhost:5432/wiki
# 管理者として許可するGoogleアカウント（カンマ区切り）
ADMIN_EMAILS=you@example.com
# 32文字以上のランダム文字列（例: openssl rand -base64 48）
SESSION_SECRET=
ADMIN_ORIGIN=http://localhost:5173
# Google Cloud Console の OAuth クライアント（承認済みリダイレクトURIに GOOGLE_REDIRECT_URI を登録）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# ローカル開発専用：Googleを通さずにこのメールでログイン（ADMIN_EMAILSに含まれている必要あり。productionでは無効）
DEV_LOGIN_EMAIL=you@example.com
PORT=8787
# 公開サイトのドメインの共通部分。wiki は {key}.{SITE_BASE_DOMAIN} で公開する（管理画面に公開URLを表示する）
SITE_BASE_DOMAIN=localhost:4321
# ワーカー・サイトのビルドが /export/public と /internal/* を呼ぶためのトークン
INTERNAL_TOKEN=
