DATABASE_URL=postgres://postgres:postgres@localhost:5432/wiki
# 最初のマイグレーションでオーナーとして登録する Google アカウント（カンマ区切り）。ユーザーが1人もいないときだけ読む
ADMIN_EMAILS=you@example.com
# 32文字以上のランダム文字列（例: openssl rand -base64 48）
SESSION_SECRET=
ADMIN_ORIGIN=http://localhost:5173
# Google Cloud Console の OAuth クライアント（承認済みリダイレクトURIに GOOGLE_REDIRECT_URI を登録）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# ローカル開発専用：Googleを通さず、このメールのユーザーをオーナーとして作ってログイン（productionでは無効）
DEV_LOGIN_EMAIL=you@example.com
PORT=8787
# 公開サイトのドメインの共通部分。wiki は {key}.{SITE_BASE_DOMAIN} で公開する（管理画面に公開URLを表示する）
SITE_BASE_DOMAIN=localhost:4321
# 公開サイトのビルドが /export/public を読むためのトークン（空なら、その経路は無効）
EXPORT_TOKEN=
# Cron のワーカーが /internal/* を呼ぶためのトークン（空なら、その経路は無効）。EXPORT_TOKEN とは別の値にする
CRON_TOKEN=
# 任意。「アクセス解析」用：Google Cloud のサービスアカウントの鍵（ダウンロードした JSON を1行にして、' で囲む）。
# 空なら、その機能だけが「未設定」になる（docs/operations.md「アクセス解析」）
GOOGLE_SERVICE_ACCOUNT_JSON=
# 任意。「SNS 連携」用：X の開発者アプリの OAuth 2.0 の Client ID / Client Secret（コールバック URL に X_REDIRECT_URI を登録）と、
# トークンを暗号化して DB に持つための鍵（32文字以上。例: openssl rand -base64 48）。3つそろわなければ、その機能だけが「未設定」になる（docs/operations.md「SNS 連携」）
# 任意。「コスト」用：Neon の API キーと組織 ID。2つそろわなければ、その機能だけが「未設定」になる（docs/operations.md「運用コスト」）
NEON_API_KEY=
NEON_ORG_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5173/api/auth/x/callback
SNS_TOKEN_KEY=
# 任意。「全体の管理」の Routine のトークンを暗号化して DB に持つための鍵（32文字以上。SNS_TOKEN_KEY とは別の値）。無ければ、その機能だけが「未設定」になる
ROUTINE_TOKEN_KEY=
