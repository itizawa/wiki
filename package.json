{
  "name": "wiki",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wiki/api --filter @wiki/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @wiki/api db:generate",
    "db:migrate": "pnpm --filter @wiki/api db:migrate",
    "db:seed": "pnpm --filter @wiki/api db:seed",
    "db:grant-owner": "pnpm --filter @wiki/api db:grant-owner"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
